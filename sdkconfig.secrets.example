# cp sdkconfig.secrets.example sdkconfig.secrets (git-ignored), then `rm -f sdkconfig` and rebuild.
# CONFIG_PP_MOCK_MODE=n
# CONFIG_PP_LTA_ACCOUNT_KEY="..."
# CONFIG_PP_ONEMAP_TOKEN="..."
# CONFIG_PP_WIFI_SSID="..."
# CONFIG_PP_WIFI_PASSWORD="..."

# ---- OneMap account. OneMap 账号（可选，让设备自己续期 token）---------------
# token 只有 3 天有效期。填了邮箱和密码后，固件遇到 401 会自动重新取 token 并重试一次，
# 你就不用每 3 天手动更新上面的 token 了（上面的 token 仍可作为首次使用的值，也可以不填）。
# 注意：这是你的 OneMap 账号密码，会以明文编进固件，绝对不要分享烧好的固件或 build/ 目录。
# CONFIG_PP_ONEMAP_EMAIL="..."
# CONFIG_PP_ONEMAP_PASSWORD="..."
